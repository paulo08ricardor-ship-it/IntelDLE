# ==============================================================================
# INTELDLE - VARIÁVEIS DE AMBIENTE E SEGURANÇA
# Copie este arquivo para .env e preencha as variáveis conforme seu ambiente.
# NUNCA versione o arquivo .env no Git com credenciais reais de produção.
# ==============================================================================

# Ambiente da Aplicação (development | production)
APP_ENV=development

# Credenciais de Inicialização do Administrador (init_sqlite.php)
# Deixe em branco se desejar que o script gere uma senha aleatória de alta entropia.
INTELDLE_ADMIN_EMAIL=Admin@gmail.com
INTELDLE_ADMIN_PASS=

# Credenciais de Inicialização do Jogador Padrão / Testes
INTELDLE_USER_EMAIL=jogador@inteldle.com
INTELDLE_USER_PASS=
